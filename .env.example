# ============ Model providers (fill what you have; gateway only enables configured ones) ============
# GLM (Zhipu) - OpenAI-compatible
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek - OpenAI-compatible
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model alias used by web/cli when user does not pick one (see packages/model-gateway/registry)
FDE_DEFAULT_MODEL=glm:glm-4.6

# Embedding model for knowledge base (OpenAI-compatible endpoint)
FDE_EMBEDDING_PROVIDER=glm
FDE_EMBEDDING_MODEL=embedding-3
FDE_EMBEDDING_DIMS=2048

# ============ Data ============
# Embedded PGlite data dir (relative to repo root)
FDE_DATA_DIR=.data/pglite

# ============ Bots ============
# Feishu (Lark) app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# WeCom (Enterprise WeChat) bot callback
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ============ CLI backends ============
# Which cli binaries are allowed for fde-agent-cli to wrap
FDE_CLI_CLAUDE_BIN=claude
FDE_CLI_CODEX_BIN=codex
FDE_CLI_CURSOR_BIN=cursor-agent

# ============ Model providers (fill what you have; gateway only enables configured ones) ============
# GLM (Zhipu) - OpenAI-compatible
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek - OpenAI-compatible
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model alias used by web/cli when user does not pick one (see packages/model-gateway/registry)
FDE_DEFAULT_MODEL=glm:glm-4.6

# Embedding for the knowledge base.
# local = on-box BGE (default). glm = Zhipu embedding-3 (needs GLM_API_KEY).
# Switching model requires re-embedding the whole knowledge base.
FDE_EMBEDDING_PROVIDER=local
FDE_EMBEDDING_MODEL=bge-small-zh-v1.5
FDE_EMBEDDING_DIMS=512
# Later eval only (do not mix with an existing index):
# FDE_EMBEDDING_MODEL=bge-base-zh-v1.5
# FDE_EMBEDDING_DIMS=768
# FDE_EMBEDDING_MODEL=bge-large-zh-v1.5
# FDE_EMBEDDING_DIMS=1024
# ONNX cache (default .data/models). Hub defaults to hf-mirror.com.
# FDE_MODEL_CACHE=.data/models
# HF_ENDPOINT=https://huggingface.co

# ============ Data ============
# Embedded PGlite data dir (relative to repo root)
FDE_DATA_DIR=.data/pglite

# ============ Bots ============
# Feishu (Lark) app - setup guide: docs/runbook/feishu-bot-setup.md
# Callback URL for the Feishu console: https://<your-domain>/api/bots/feishu
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# Event subscription credentials: set at least one (ENCRYPT_KEY recommended: AES + signature check)
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# Optional: Lark international -> https://open.larksuite.com (default https://open.feishu.cn)
FEISHU_BASE_URL=
# Optional, shared by all bots: model alias / knowledge base used for bot conversations
FDE_BOT_MODEL=
FDE_BOT_KNOWLEDGE_BASE_ID=
# WeCom (Enterprise WeChat) bot callback
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=

# ============ CLI backends ============
# Which cli binaries are allowed for fde-agent-cli to wrap
FDE_CLI_CLAUDE_BIN=claude
FDE_CLI_CODEX_BIN=codex
FDE_CLI_CURSOR_BIN=cursor-agent

# ============ Model providers (fill what you have; gateway only enables configured ones) ============
# GLM (Zhipu) - OpenAI-compatible
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# DeepSeek - OpenAI-compatible
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
# Anthropic Claude
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com

# Default model alias used by web/cli when user does not pick one (see packages/model-gateway/registry)
FDE_DEFAULT_MODEL=glm:glm-4.6
FDE_DEFAULT_BACKEND=api

# Embedding model for knowledge base (OpenAI-compatible endpoint)
FDE_EMBEDDING_PROVIDER=glm
FDE_EMBEDDING_MODEL=embedding-3
FDE_EMBEDDING_DIMS=2048
# 单块字符上限：按模型的 token 上限折算，切分器用它决定块大小（如 GLM embedding-3 → 1400）
FDE_EMBEDDING_MAX_INPUT_CHARS=1400
# 端点全局覆盖（可选；不设则用所选厂商的 <PROVIDER>_BASE_URL）
# FDE_EMBEDDING_BASE_URL=
FDE_EMBEDDING_TIMEOUT_MS=30000
# 知识库检索条数（默认 5；库大时可调高，代价是 prompt 更长）
FDE_KB_TOP_K=5

# ============ Data ============
# Embedded PGlite data dir (relative to repo root)
FDE_DATA_DIR=.data/pglite

# ============ Bots ============
# Feishu (Lark) app
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# WeCom (Enterprise WeChat) bot callback
WECOM_CORP_ID=
WECOM_AGENT_ID=
WECOM_SECRET=
WECOM_CALLBACK_TOKEN=
WECOM_CALLBACK_AES_KEY=
FDE_BOT_BACKEND=api
# Optional: knowledge base used by bot chat and messages starting with "诊断："
FDE_BOT_KNOWLEDGE_BASE_ID=

# ============ CLI backends ============
# Which cli binaries are allowed for fde-agent-cli to wrap
FDE_CLAUDE_BIN=claude
FDE_CODEX_BIN=codex
# Cursor Agent CLI binary (official install: curl https://cursor.com/install -fsS | bash)
FDE_CURSOR_BIN=agent
# Optional auth for headless Cursor CLI (or run: agent login)
# CURSOR_API_KEY=
FDE_CLI_TIMEOUT_MS=120000

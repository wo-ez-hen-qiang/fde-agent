#!/usr/bin/env bash
# fde-agent git 门禁：每次提交前必须通过全部检查。
# 由 ai-coding skill 规定；紧急绕过用 git commit --no-verify（必须在提交信息中说明原因）。
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
export PATH="$HOME/.local/node/bin:$PATH"

echo "[gate] 1/3 版本三方同步（VERSION / package.json / CHANGELOG）..."
PKG_VER=$(node -p "require('./package.json').version")
FILE_VER=$(tr -d '[:space:]' < VERSION 2>/dev/null || echo "MISSING")
if [ "$FILE_VER" = "MISSING" ]; then
  echo "[gate] 失败：缺少 VERSION 文件（ai-coding 规范：里程碑提交必须同步 VERSION）" >&2
  exit 1
fi
if [ "$PKG_VER" != "$FILE_VER" ]; then
  echo "[gate] 失败：VERSION($FILE_VER) 与 package.json($PKG_VER) 不一致" >&2
  exit 1
fi
CHANGELOG_VER=$(grep -oP '(?<=## \[)[0-9]+\.[0-9]+\.[0-9]+(?=\])' CHANGELOG.md 2>/dev/null | head -1 || true)
if [ -z "$CHANGELOG_VER" ]; then
  echo "[gate] 失败：CHANGELOG.md 缺少版本小节（格式：## [x.y.z] - yyyy-mm-dd）" >&2
  exit 1
fi
if [ "$CHANGELOG_VER" != "$FILE_VER" ]; then
  echo "[gate] 失败：CHANGELOG 最新版本($CHANGELOG_VER) 与 VERSION($FILE_VER) 不一致" >&2
  exit 1
fi

echo "[gate] 2/3 pnpm typecheck..."
pnpm typecheck

echo "[gate] 3/3 pnpm lint..."
pnpm lint

echo "[gate] 全部通过"
